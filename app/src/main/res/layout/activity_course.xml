<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".CourseActivity">

        <!-- Main content of the screen -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

                <!-- Title of the course -->
                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course Title"
                    android:textSize="24sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="16dp" />

                <!-- Description of the course -->
                <TextView
                    android:id="@+id/descriptionTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course Description"
                    android:layout_below="@id/titleTextView"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp" />

                <!-- Deadline of the course -->
                <TextView
                    android:id="@+id/deadlineTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course Deadline"
                    android:layout_below="@id/descriptionTextView"
                    android:layout_marginTop="8dp"
                    android:textSize="18sp" />

                <!-- ImageView for course image -->
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_below="@id/deadlineTextView"
                    android:layout_marginTop="16dp"
                    android:scaleType="centerCrop" />

                <!-- FloatingActionButton for deleting the course -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:contentDescription="Supprimer"
                    android:id="@+id/deletebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="16dp"
                    android:layout_alignParentBottom="true"
                    app:srcCompat="@drawable/baseline_delete_24"
                    app:backgroundTint="@color/my_primary" />

                <!-- FloatingActionButton for updating the course -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:contentDescription="Ajouter"
                    android:id="@+id/updatebutton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_margin="16dp"
                    android:layout_alignParentBottom="true"
                    app:srcCompat="@drawable/baseline_edit_24"
                    app:backgroundTint="@color/my_primary" />

        </RelativeLayout>

        <!-- Navigation drawer -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:headerLayout="@layout/nav_header"
            app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
