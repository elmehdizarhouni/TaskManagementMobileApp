<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".UpdateCourseActivity"
    tools:openDrawer="start">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="16dp"
        android:background="@color/white">

        <!-- Champ pour le sujet du cours -->
        <EditText
            android:id="@+id/subject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter the Course Subject"
            android:fontFamily="@font/myfont"
            android:inputType="text"
            android:textSize="18sp" />

        <!-- Champ pour la description du cours -->
        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Course Description"
            android:fontFamily="@font/myfont"
            android:layout_below="@id/subject"
            android:inputType="text"
            android:textSize="18sp" />

        <!-- Champ pour la date du cours -->
        <EditText
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Course Date"
            android:fontFamily="@font/myfont"
            android:layout_below="@id/description"
            android:inputType="text"
            android:textSize="18sp" />

        <!-- Champ pour le nom de l'enseignant -->
        <EditText
            android:id="@+id/teacher"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Teacher Name"
            android:fontFamily="@font/myfont"
            android:layout_below="@id/date"
            android:inputType="text"
            android:textSize="18sp" />

        <!-- Bouton pour sélectionner une image -->
        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/teacher"
            app:backgroundTint="@color/my_primary"
            android:fontFamily="@font/myfont"
            android:text="Select Image"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Aperçu de l'image sélectionnée -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnSelectImage"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:layout_marginBottom="16dp" />

        <!-- Bouton pour mettre à jour le cours -->
        <Button
            android:id="@+id/btnUpdateCourse"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@id/imageView"
            app:backgroundTint="@color/my_primary"
            android:fontFamily="@font/myfont"
            android:text="Update Course" />
    </RelativeLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
